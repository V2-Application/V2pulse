<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS site "V2Pulse": host v2pulse.v2retail.com -> V2Pulse service on 127.0.0.1:8875 (ARR + URL Rewrite).
     Only requests for this host name land here; the other sites on :80 keep their own bindings.
     V2Pulse trusts X-Forwarded-For from 127.0.0.1 (PULSE_TRUSTED_PROXIES), so logs show the real client IP. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="V2PulseProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8875/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>